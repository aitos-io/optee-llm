+			EMSG("Ending thread %zu: its TA instance is condemned", n);
+			/* logged as a panic: no abort to describe */
+			threads[n].tsd.abort_type = ABORT_TYPE_USER_MODE_PANIC;
+			end_condemned(&threads[n].regs);
+		}
+	}
+#endif
