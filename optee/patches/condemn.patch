+bool __weak thread_user_ctx_condemned(struct ts_ctx *ctx __unused)
+{
+	return false;
+}
+
+#ifdef ARM64
+#ifdef CFG_CORE_PAUTH
+#error "condemn.patch: also set the thread's APIA key, as abort.c does"
+#endif
+/*
+ * Ends user mode execution of a thread suspended there, as
+ * handle_user_mode_panic() in abort.c does for an abort: it resumes in
+ * thread_unwind_user_mode() on its kernel stack, the TA panicked with
+ * TEE_ERROR_TARGET_DEAD.
+ */
+static void end_condemned(struct thread_ctx_regs *regs)
+{
+	uint32_t daif = (regs->cpsr >> SPSR_32_AIF_SHIFT) & SPSR_32_AIF_MASK;
+	uint64_t pan_bit = 0;
+
+	if (IS_ENABLED(CFG_PAN) && feat_pan_implemented() && read_pan())
+		pan_bit = SPSR_64_PAN;
+	regs->x[0] = TEE_ERROR_TARGET_DEAD;
+	regs->x[1] = true;
+	regs->x[2] = TEE_ERROR_TARGET_DEAD;
+	regs->pc = (vaddr_t)thread_unwind_user_mode;
+	regs->sp = thread_get_saved_thread_sp();
+	regs->cpsr = SPSR_64(SPSR_64_MODE_EL1, SPSR_64_MODE_SP_EL0, daif) |
+		     pan_bit;
+}
+#endif /*ARM64*/
+
